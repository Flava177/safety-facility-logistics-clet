# --- App shell -------------------------------------------------------------
VITE_APP_VERSION=$npm_package_version
VITE_APP_PORT=5005
VITE_BASENAME=/

# --- SFL Fleet & Logistics service (S166) ----------------------------------
VITE_FLEET_API_BASE_URL=http://localhost:8093

# --- Development actor headers ---------------------------------------------
# Sent as X-SFL-User / X-SFL-Display-Name / X-SFL-Roles / X-SFL-Sites on every
# request. Ignored once the services run behind OIDC, where the same
# ActorContext is built from the JWT instead.
VITE_SFL_USER=fleet.operator
VITE_SFL_DISPLAY_NAME=Fleet Operator
VITE_SFL_ROLES=FLEET_MANAGER,FLEET_DISPATCHER,FLEET_AUDITOR
VITE_SFL_SITES=CLET-HQ

# Clearly-named development fallback switch. Leave false: no screen may present
# mock data as if it came from the service.
VITE_FLEET_DEV_FALLBACK=false
