# Production build. The Fleet service serves this bundle from /ui/ on the same origin as the API,
# so the base URL is deliberately empty — every request is same-origin and no CORS is involved.
VITE_BASENAME=/ui/
VITE_FLEET_API_BASE_URL=

# The emergency notification service is NOT on that origin - it is a separate service on port 8095,
# so this one cannot be empty. Behind a gateway that fronts both services, set it to the path prefix
# the gateway routes to S174 and it becomes same-origin like the rest.
VITE_EMERGENCY_API_BASE_URL=http://localhost:8095

VITE_SFL_USER=fleet.operator
VITE_SFL_DISPLAY_NAME=Fleet Operator
VITE_SFL_ROLES=FLEET_MANAGER,FLEET_DISPATCHER,FLEET_AUDITOR,EMERGENCY_COORDINATOR,COMMAND_ROLE,AUDITOR,INTEGRATION_ENGINEER
VITE_SFL_SITES=CLET-HQ
VITE_FLEET_DEV_FALLBACK=false
