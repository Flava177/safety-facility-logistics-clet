# Production build of the dashboard as a standalone application.
#
# This bundle used to be packaged into the Fleet service and served from /ui/ on the same origin as
# the API, which is why the API base URLs below were empty — every call was same-origin and CORS
# never came into it. The backend no longer serves any UI, so all three are now explicit
# cross-origin addresses and the browser will enforce CORS on every one of them.
#
# Two things follow. Each service must name this bundle's origin in SFL_CORS_ALLOWED_ORIGINS, or the
# calls fail in the browser while every equivalent curl succeeds. And these values are baked in at
# build time by Vite — pointing at a different environment means rebuilding, not re-deploying.
VITE_BASENAME=/
VITE_FLEET_API_BASE_URL=http://localhost:8093
VITE_FACILITIES_API_BASE_URL=http://localhost:8091
VITE_EMERGENCY_API_BASE_URL=http://localhost:8095

VITE_SFL_USER=fleet.operator
VITE_SFL_DISPLAY_NAME=Fleet Operator
VITE_SFL_ROLES=FLEET_MANAGER,DISPATCH_CONTROLLER,FLEET_REPORTING_VIEWER,EMERGENCY_COORDINATOR,COMMAND_ROLE,AUDITOR,INTEGRATION_ENGINEER
VITE_SFL_SITES=CLET-HQ
VITE_FLEET_DEV_FALLBACK=false

# Programme and system entitlement are both derived from VITE_SFL_ROLES, which is what IAM will do
# once it is integrated. Neither override is set here on purpose: a build that forced one programme or
# one system would show every user the same slice regardless of who they are.
#   VITE_SFL_PROGRAMMES=FTLMP    # one programme, ignoring the roles
#   VITE_SFL_SYSTEMS=S171        # one system, ignoring the roles
