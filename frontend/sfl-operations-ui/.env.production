# Production build. The Fleet service serves this bundle from /ui/ on the same origin as the API,
# so the base URL is deliberately empty — every request is same-origin and no CORS is involved.
VITE_BASENAME=/ui/
VITE_FLEET_API_BASE_URL=

# The SSEMP service is NOT on that origin - it is a separate service on port 8092, so this one
# cannot be empty. Behind a gateway that fronts both services, set it to the path prefix the gateway
# routes to SSEMP and it becomes same-origin like the rest.
VITE_SAFETY_SECURITY_API_BASE_URL=http://localhost:8092

VITE_SFL_USER=fleet.operator
VITE_SFL_DISPLAY_NAME=Fleet Operator
VITE_SFL_ROLES=FLEET_MANAGER,DISPATCH_CONTROLLER,FLEET_REPORTING_VIEWER,EMERGENCY_COORDINATOR,COMMAND_ROLE,AUDITOR,INTEGRATION_ENGINEER
VITE_SFL_SITES=CLET-HQ
VITE_FLEET_DEV_FALLBACK=false

# Programme and system entitlement are both derived from VITE_SFL_ROLES, which is what IAM will do
# once it is integrated. Neither override is set here on purpose: a build that forced one programme or
# one system would show every user the same slice regardless of who they are.
#   VITE_SFL_PROGRAMMES=FTLMP    # one programme, ignoring the roles
#   VITE_SFL_SYSTEMS=S171        # one system, ignoring the roles

# Google Places for origin/destination. Deliberately NOT SET here: this file is tracked, and a key
# committed to git is a key you cannot rotate quietly. Supply it from the deployment environment.
# Unset means the fields fall back to free text with recent-value suggestions.
#
# Not merely commented out for tidiness - the line used to read `VITE_GOOGLE_MAPS_API_KEY=`, and an
# empty assignment is not the same as an absent one. Vite layers `.env` then `.env.production`, with
# the mode file winning, so the empty value here *overrode* a key set in `.env`. Every bundle built on
# a developer machine therefore shipped with no key, the dashboard served from the service at /ui
# could never offer a suggestion, and nothing said so. The dev server on 5005 was unaffected, which is
# why it looked like it worked.
#
# Absent is correct. A real VITE_GOOGLE_MAPS_API_KEY in the build environment still wins over both
# files (Vite applies process env last), so deployment is unchanged and local builds now behave.
#   VITE_GOOGLE_MAPS_API_KEY=
