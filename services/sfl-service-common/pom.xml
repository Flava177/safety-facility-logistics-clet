<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>gh.edu.clet.sfl</groupId>
        <artifactId>sfl-services</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>sfl-service-common</artifactId>
    <name>SFL Service Common</name>
    <description>Shared DTO, error, auth-context, site-scope and event-envelope conventions.</description>
    <dependencies>
        <!--
          ADR 0007. The site-scope GUC belongs in the shared kernel because all four services enforce
          the same rule against their own schema, and a copy per service is four places for it to
          drift. These are the narrowest dependencies that allow it: a transaction listener and a way
          to reach the transaction's connection. No starter, so this stays a library.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies></project>

