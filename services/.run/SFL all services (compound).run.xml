<component name="ProjectRunConfigurationManager">
  <!--
    Reuse the canonical service configurations here. A second set of "API only" configurations used
    to point at these same ports; if a service had already been launched on its own, the compound
    could start a differently named duplicate and that duplicate failed with "port already in use".
    Using one launch identity per service makes individual and compound runs behave consistently and
    lets IntelliJ manage their lifecycle correctly. Each API may open its Swagger page, but its own
    dashboard opening is disabled. The portal is the only dashboard origin and uses the signed-in
    actor's roles and permissions to render the systems available to that account.
  -->
  <configuration folderName="SFL" name="SFL all services (compound)" type="CompoundRunConfigurationType">
    <toRun name="IFIMP facilities 8091" type="SpringBootApplicationConfigurationType" />
    <toRun name="SSEMP safety security 8092" type="SpringBootApplicationConfigurationType" />
    <toRun name="FTLMP fleet logistics 8093" type="SpringBootApplicationConfigurationType" />
    <toRun name="SFL portal 8090" type="SpringBootApplicationConfigurationType" />
    <method v="2" />
  </configuration>
</component>
