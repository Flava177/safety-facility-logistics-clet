SFL_FLEET_LOGISTICS_DB_URL=jdbc:postgresql://localhost:5443/sfl__fleet_vehicle_service
SFL_DB_USERNAME=sfl
# LOCAL DEVELOPMENT ONLY. This password and the disabled security below must never be used as-is
# outside a developer's own machine - set real values (see deploy/env/.env.example) everywhere else.
SFL_DB_PASSWORD=sfl
SFL_SECURITY_ENABLED=false
SFL_FLEET_EVENT_TRANSPORT=local
SFL_FLEET_NOTIFICATION_PROVIDER=recorded
SFL_RABBITMQ_HEALTH_ENABLED=false
SFL_PORT=8093
