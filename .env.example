SFL_DB_URL=jdbc:postgresql://localhost:5434/sfl_java
SFL_DB_USERNAME=postgres
SFL_DB_PASSWORD=change-me
SFL_PORT=8081
# Secure by default even in this example file. Uncomment the next line only on your own machine, only
# when you need the X-SFL-* header shortcut instead of a real token - never in anything shared.
# SFL_SECURITY_ENABLED=false
SFL_IAM_ISSUER=http://localhost:8080
SFL_REDIS_HOST=localhost
SFL_RABBITMQ_HOST=localhost

# JWKS fetch timeouts (all services) - bounds how long token validation can block on a slow/unreachable IdP
SFL_JWKS_CONNECT_TIMEOUT=PT3S
SFL_JWKS_READ_TIMEOUT=PT3S

# HikariCP / Tomcat sizing (all services unless noted) - see docs/architecture/2026-09-10-final-issues-verification.md
# M11: these are framework-documented starting defaults, not numbers sized against a real database's
# max_connections or measured production traffic - treat as a starting point pending that sign-off.
SFL_DB_POOL_MAX_SIZE=10
SFL_DB_POOL_CONNECTION_TIMEOUT_MS=30000
SFL_WEB_MAX_THREADS=20
SFL_WEB_MIN_SPARE_THREADS=4

# Facilities booking advisory-lock timeout - bounds how long a contended room booking holds a Hikari connection
SFL_BOOKING_ADVISORY_LOCK_TIMEOUT=PT5S

# Bounded audit-chain verification paging (facilities + fleet)
SFL_AUDIT_VERIFICATION_BATCH_SIZE=5000
SFL_AUDIT_VERIFICATION_MAX_BATCHES=200

