<component name="ProjectRunConfigurationManager">
  <!--
    One-click fallback for when the Stop button on "SFL all services" is greyed out (it runs in a
    terminal and backgrounds three separate java processes, so IntelliJ regularly loses track of
    them - see scripts/dev/stop-all.sh for the full explanation). Kills whatever is listening on
    8091/8092/8093 directly, by port, no matter how it was started.
  -->
  <configuration folderName="SFL" default="false" name="SFL stop all" type="ShConfigurationType">
    <option name="SCRIPT_PATH" value="$PROJECT_DIR$/../scripts/dev/stop-all.sh" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="false" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$/.." />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="false" />
    <option name="INTERPRETER_PATH" value="/bin/bash" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="false" />
    <option name="EXECUTE_IN_TERMINAL" value="false" />
    <option name="EXECUTE_SCRIPT_FILE" value="true" />
    <envs />
    <method v="2" />
  </configuration>
</component>
